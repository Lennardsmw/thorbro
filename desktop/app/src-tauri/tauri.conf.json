{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThorBro",
  "version": "0.1.0",
  "identifier": "wtf.lennard.thorbro.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ThorBro",
        "width": 520,
        "height": 680,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}